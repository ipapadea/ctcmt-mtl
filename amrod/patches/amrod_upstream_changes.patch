+_C.SOLVER.CTCMT_SEG_LOSS_SCALE_PRESERVE = False
+
+# Mode-covering KL(anchor || student) on the predicted class marginal.
+_C.SOLVER.CTCMT_ANCHOR_MARGINAL_WEIGHT = 0.0
