+# threshold has to be guessed.
+_C.SOLVER.CTCMT_ADAPTIVE_ROUTING = False
+_C.SOLVER.CTCMT_ADAPTIVE_ROUTING_BETA = 0.98
+_C.SOLVER.CTCMT_ADAPTIVE_ROUTING_EMA = 0.99
